# dipci.tr Canlı Sunucu Ortam Değişkenleri (.env)
# Bu dosyayı sunucuda `.env` adıyla kopyalayıp doldurun.

# 1. Netgsm Resmi SMS Doğrulama (OTP) Bilgileri
NETGSM_USERCODE=850XXXXXXX
NETGSM_PASSWORD=ALT_KULLANICI_API_SIFRENIZ
NETGSM_MSGHEADER=ONAYLI_SMS_BASLIGINIZ
# OTP paketiniz varsa "otp", standart SMS paketiniz varsa "standard" yazın:
NETGSM_MODE=otp

# 2. Gelir Ortaklığı Kimlikleri
AMAZON_TAG=marketdedekti-21
REKLAMACTION_PUB_ID=
ADMITAD_CAMPAIGN_ID=

# 3. Kamera Görsel & Raf Etiketi Okuma (Gemini Flash API)
GEMINI_API_KEY=

# 4. Giriş / Doğrulama
# Google ile giriş: Google Cloud Console > OAuth istemci kimliği. Boşsa Google girişi kapalıdır.
GOOGLE_CLIENT_ID=
# E-posta OTP gönderimi (biri yeterli). İkisi de boşsa e-posta ile giriş kapalıdır.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=dogrulama@dipci.tr
# SADECE yerel geliştirme: 1 yapılırsa doğrulama kodu API yanıtında döner. CANLIDA ASLA 1 YAPMAYIN.
DIPCI_DEMO_AUTH=0
# API belgeleri (/docs, /openapi.json). Canlıda kapalı kalmalı.
DIPCI_ENABLE_DOCS=0
